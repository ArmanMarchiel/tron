<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tron_ros2_collector</name>
  <version>0.1.0</version>
  <description>ROS 2 adapter for the TRON cyber-physical digital twin: observes the ROS graph and robot topics and forwards normalised events to the platform.</description>
  <maintainer email="arman.marchiel23@gmail.com">TRON</maintainer>
  <license>Proprietary</license>
  <depend>rclpy</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>builtin_interfaces</depend>
  
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_msgs</depend>
  <export><build_type>ament_python</build_type></export>
</package>
