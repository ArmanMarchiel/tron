<!-- Haas VF-2 built from the manufacturer-style CAD (SolidWorks 2017 STEP, GrabCAD), tessellated to
     a MuJoCo binary mesh by backend/scripts/cad_import.py.

     The CAD shell is the *visual* geometry only.  MuJoCo collides every mesh as its convex hull, so
     a hollow enclosure imported as one mesh would be a solid block the robot could never reach into;
     collision therefore comes from the primitive boxes below, which leave the door aperture open.
     Shell and collision boxes are both authored against the same measured frames:

       footprint   2.325 deep (x) x 2.504 wide (y) x 2.278 high (z), origin centred in plan, base z=0
       front face  x = -1.162   (the door side, facing the robot)
       table top   z = 0.83     spanning x -0.93..-0.22

     __POS__ is the machine origin at floor level.  Contract: cnc_door_joint, cnc_jaw_l/r_joint,
     cnc_chuck_site.  Structural geoms use contype 4 / conaffinity 3 so the machine never collides
     with itself but still blocks the robot (1) and parts (2). -->
<body name="cnc_machine" pos="__POS__">

  <!-- ============ visual: the CAD shell, one mesh per colour in the source model ============ -->
__SHELL_GEOMS__

  <!-- ============ collision: primitives that keep the working volume open ============ -->
  <!-- base casting -->
  <geom name="cnc_base" type="box" size="1.16 1.25 0.36" pos="0 0 0.36" material="haas_base" contype="4" conaffinity="3" group="3"/>
  <!-- side walls and back, leaving the front aperture clear -->
  <geom name="cnc_side_l" type="box" size="1.16 0.06 0.58" pos="0 1.19 1.30" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_side_r" type="box" size="1.16 0.06 0.58" pos="0 -1.19 1.30" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_back" type="box" size="0.06 1.25 0.58" pos="1.10 0 1.30" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_roof" type="box" size="1.16 1.25 0.05" pos="0 0 1.93" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <!-- front pillars flanking the 0.94 m door opening -->
  <geom name="cnc_front_pillar_l" type="box" size="0.06 0.391 0.58" pos="-1.10 0.861 1.30" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_front_pillar_r" type="box" size="0.06 0.391 0.58" pos="-1.10 -0.861 1.30" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_front_sill" type="box" size="0.06 1.25 0.06" pos="-1.10 0 0.78" material="haas_panel" contype="4" conaffinity="3" group="3"/>
  <!-- machine bed / chip pan and the column behind the table -->
  <geom name="cnc_chip_pan" type="box" size="1.02 1.16 0.03" pos="0 0 0.75" material="haas_chip" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_column" type="box" size="0.34 0.55 0.55" pos="0.74 0 1.33" material="haas_shell" contype="4" conaffinity="3" group="3"/>

  <!-- ============ table and vise ============ -->
  <geom name="cnc_table" type="box" size="0.36 0.18 0.03" pos="-0.58 0 0.80" material="cnc_bed" contype="4" conaffinity="3" group="3"/>

  <body name="cnc_chuck" pos="-0.62 0 0.86">
    <geom name="cnc_vise_body" type="box" size="0.13 0.12 0.05" pos="0 0 0" material="cnc_chuck" contype="4" conaffinity="3"/>
    <body name="cnc_jaw_l" pos="0 0.115 0.075">
      <joint name="cnc_jaw_l_joint" type="slide" axis="0 -1 0" range="0 0.055" damping="40"/>
      <geom name="cnc_jaw_l_geom" type="box" size="0.085 0.022 0.045" material="cnc_jaw" contype="4" conaffinity="3"/>
    </body>
    <body name="cnc_jaw_r" pos="0 -0.115 0.075">
      <joint name="cnc_jaw_r_joint" type="slide" axis="0 1 0" range="0 0.055" damping="40"/>
      <geom name="cnc_jaw_r_geom" type="box" size="0.085 0.022 0.045" material="cnc_jaw" contype="4" conaffinity="3"/>
    </body>
  </body>

  <!-- ============ doors ============
       The CAD shell already carries the VF-2's twin doors, so this model draws none of its own.
       The door still has to *work*: the tending task opens it before reaching in and the PLC reports
       its position, so a single invisible slide joint carries that state and a thin collision slab
       blocks the aperture while the door is shut.  Opening slides the slab clear. -->
  <body name="cnc_door" pos="-0.86 0 1.25">
    <joint name="cnc_door_joint" type="slide" axis="0 -1 0" range="0 0.94" damping="60"/>
    <geom name="cnc_door_panel" type="box" size="0.02 0.47 0.42" material="haas_glass"
          contype="4" conaffinity="3" rgba="0 0 0 0"/>
  </body>

  <site name="cnc_chuck_site" pos="-0.62 0 0.942" size="0.006" rgba="0 0 0 0"/>
</body>
