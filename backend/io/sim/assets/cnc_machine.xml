<!-- Small machining centre, shallow open-fronted enclosure loaded from the front/top: side walls, back wall,
     a partial roof over the rear half, a low sill, a sliding door on an actuated slide joint covering the
     front opening, a chuck with two jaws, a spindle prop and a status beacon. __POS__ is the machine origin;
     the front face is at x = -0.18 relative to it. Interior volume is used by the 'cnc_interior' zone. -->
<body name="cnc_machine" pos="__POS__">
  <geom name="cnc_base" type="box" size="0.18 0.34 0.02" pos="0 0 -0.02" material="cnc_body"/>
  <geom name="cnc_back" type="box" size="0.02 0.34 0.42" pos="0.16 0 0.42" material="cnc_body"/>
  <geom name="cnc_side_l" type="box" size="0.18 0.02 0.42" pos="0 0.32 0.42" material="cnc_body"/>
  <geom name="cnc_side_r" type="box" size="0.18 0.02 0.42" pos="0 -0.32 0.42" material="cnc_body"/>
  <geom name="cnc_roof" type="box" size="0.08 0.34 0.02" pos="0.10 0 0.84" material="cnc_body"/>
  <geom name="cnc_front_sill" type="box" size="0.01 0.34 0.03" pos="-0.17 0 0.03" material="cnc_body"/>
  <geom name="cnc_bed" type="box" size="0.14 0.24 0.03" pos="0.0 0 0.03" material="cnc_bed"/>
  <geom name="cnc_column" type="box" size="0.05 0.12 0.38" pos="0.11 0 0.42" material="cnc_bed"/>
  <geom name="cnc_spindle_head" type="box" size="0.09 0.09 0.05" pos="0.04 0 0.91" material="cnc_body"/>
  <geom name="cnc_spindle" type="cylinder" size="0.02 0.05" pos="-0.06 0 0.81" material="cnc_spindle"/>
  <geom name="cnc_beacon" type="cylinder" size="0.02 0.03" pos="0.1 0.28 0.89" material="beacon_idle"/>
  <body name="cnc_chuck" pos="-0.06 0 0.06">
    <geom name="cnc_chuck_body" type="cylinder" size="0.07 0.02" pos="0 0 0.0" material="cnc_chuck"/>
    <body name="cnc_jaw_l" pos="0 0.085 0.02">
      <joint name="cnc_jaw_l_joint" type="slide" axis="0 -1 0" range="0 0.04" damping="20"/>
      <geom name="cnc_jaw_l_geom" type="box" size="0.02 0.006 0.02" material="cnc_jaw" contype="2" conaffinity="2"/>
    </body>
    <body name="cnc_jaw_r" pos="0 -0.085 0.02">
      <joint name="cnc_jaw_r_joint" type="slide" axis="0 1 0" range="0 0.04" damping="20"/>
      <geom name="cnc_jaw_r_geom" type="box" size="0.02 0.006 0.02" material="cnc_jaw" contype="2" conaffinity="2"/>
    </body>
  </body>
  <body name="cnc_door" pos="-0.185 0 0.40">
    <joint name="cnc_door_joint" type="slide" axis="0 0 1" range="0 0.78" damping="30"/>
    <geom name="cnc_door_panel" type="box" size="0.01 0.31 0.34" material="cnc_door"/>
    <geom name="cnc_door_window" type="box" size="0.011 0.18 0.14" pos="0 0 0.08" material="cnc_window"/>
    <geom name="cnc_door_handle" type="box" size="0.015 0.02 0.06" pos="-0.02 -0.25 0" material="cnc_jaw"/>
  </body>
  <site name="cnc_chuck_site" pos="-0.06 0 0.1" size="0.004" rgba="0 0 0 0"/>
</body>
