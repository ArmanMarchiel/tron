<!-- Haas VC-400 twin-pallet vertical machining centre with its 6+1 pallet pool, from the
     manufacturer CAD (SolidWorks 2020 STEP, 1.4M entities), tessellated by
     backend/scripts/cad_machine.py into one mesh per colour so the render matches the real machine.

     The shell is visual only: MuJoCo collides a mesh as its convex hull, so the enclosure's
     collision comes from the primitives below, which leave the door aperture open.

       assembly    3.255 deep (x) x 5.310 wide (y) -- the pallet pool accounts for most of the width
       front face  x = -1.60   (the door side, facing the robot)
       pallet      spindle-side pallet at x = -0.40, z = 1.10

     __POS__ is the machine origin at floor level.  Contract: cnc_door_joint, cnc_jaw_l/r_joint,
     cnc_chuck_site.  Structural geoms use contype 4 / conaffinity 3 so the machine never collides
     with itself but still blocks the robot (1) and parts (2). -->
<body name="cnc_machine" pos="__POS__">

  <!-- ============ visual: the CAD shell ============ -->
__SHELL_GEOMS__

  <!-- ============ collision: primitives that keep the working volume open ============ -->
  <geom name="cnc_base" type="box" size="1.60 1.35 0.50" pos="0 0 0.50" material="haas_base" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_side_l" type="box" size="1.60 0.06 0.75" pos="0 1.29 1.75" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_side_r" type="box" size="1.60 0.06 0.75" pos="0 -1.29 1.75" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_back" type="box" size="0.06 1.35 0.75" pos="1.54 0 1.75" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_roof" type="box" size="1.60 1.35 0.05" pos="0 0 2.55" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <!-- front pillars flanking the 0.80 m door opening -->
  <geom name="cnc_front_pillar_l" type="box" size="0.06 0.95 0.75" pos="-1.54 0.40 1.75" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_front_pillar_r" type="box" size="0.06 0.95 0.75" pos="-1.54 -0.40 1.75" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_front_sill" type="box" size="0.06 1.35 0.05" pos="-1.54 0 1.05" material="haas_panel" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_bed" type="box" size="1.20 1.20 0.03" pos="0 0 1.00" material="haas_chip" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_column" type="box" size="0.40 0.70 0.70" pos="1.05 0 1.75" material="haas_shell" contype="4" conaffinity="3" group="3"/>

  <!-- ============ pallet and vise ============ -->
  <geom name="cnc_table" type="box" size="0.28 0.19 0.03" pos="-0.40 0 1.03" material="cnc_bed" contype="4" conaffinity="3" group="3"/>

  <body name="cnc_chuck" pos="-0.40 0 1.06">
    <geom name="cnc_vise_body" type="box" size="0.13 0.12 0.05" pos="0 0 0" material="cnc_chuck" contype="4" conaffinity="3"/>
    <body name="cnc_jaw_l" pos="0 0.115 0.075">
      <joint name="cnc_jaw_l_joint" type="slide" axis="0 -1 0" range="0 0.055" damping="40"/>
      <geom name="cnc_jaw_l_geom" type="box" size="0.085 0.022 0.045" material="cnc_jaw" contype="4" conaffinity="3"/>
    </body>
    <body name="cnc_jaw_r" pos="0 -0.115 0.075">
      <joint name="cnc_jaw_r_joint" type="slide" axis="0 1 0" range="0 0.055" damping="40"/>
      <geom name="cnc_jaw_r_geom" type="box" size="0.085 0.022 0.045" material="cnc_jaw" contype="4" conaffinity="3"/>
    </body>
  </body>

  <!-- ============ door ============
       The CAD shell draws the VC-400's own door; this invisible slab carries the collision and the
       PLC's position state, and slides clear when the door opens. -->
  <body name="cnc_door" pos="-1.54 0 1.75">
    <joint name="cnc_door_joint" type="slide" axis="0 -1 0" range="0 0.80" damping="60"/>
    <geom name="cnc_door_panel" type="box" size="0.02 0.40 0.70" material="haas_glass"
          contype="4" conaffinity="3" rgba="0 0 0 0"/>
  </body>

  <site name="cnc_chuck_site" pos="-0.40 0 1.10" size="0.006" rgba="0 0 0 0"/>
</body>
