<!-- Haas ST-10 turning centre, from the manufacturer CAD (SolidWorks 2015 STEP, GrabCAD),
     tessellated by backend/scripts/cad_machine.py into one mesh per colour so the render matches
     the real machine.

     A lathe holds the part in a horizontal chuck on the spindle, rather than a vise on a table, so
     the "jaws" here are the chuck jaws and the part is gripped on its axis.  The shell is visual
     only -- MuJoCo collides a mesh as its convex hull -- so the enclosure's collision comes from the
     primitives below, which leave the door aperture open.

       footprint   2.595 deep (x) x 2.920 wide (y) x 2.818 high (z), origin centred in plan, base z=0
       front face  x = -1.30    (the door side, facing the robot)
       chuck       x = -0.35, spindle centreline z = 1.05

     __POS__ is the machine origin at floor level.  Contract: cnc_door_joint, cnc_jaw_l/r_joint,
     cnc_chuck_site.  Structural geoms use contype 4 / conaffinity 3 so the machine never collides
     with itself but still blocks the robot (1) and parts (2). -->
<body name="cnc_machine" pos="__POS__">

  <!-- ============ visual: the CAD shell ============ -->
__SHELL_GEOMS__

  <!-- ============ collision: primitives that keep the working volume open ============ -->
  <geom name="cnc_base" type="box" size="1.29 1.45 0.45" pos="0 0 0.45" material="haas_base" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_side_l" type="box" size="1.29 0.06 0.55" pos="0 1.39 1.45" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_side_r" type="box" size="1.29 0.06 0.55" pos="0 -1.39 1.45" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_back" type="box" size="0.06 1.45 0.55" pos="1.23 0 1.45" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_roof" type="box" size="1.29 1.45 0.05" pos="0 0 2.05" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <!-- front pillars flanking the 0.70 m door opening -->
  <geom name="cnc_front_pillar_l" type="box" size="0.06 1.09 0.55" pos="-1.24 0.36 1.45" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_front_pillar_r" type="box" size="0.06 1.09 0.55" pos="-1.24 -0.36 1.45" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_front_sill" type="box" size="0.06 1.45 0.05" pos="-1.24 0 0.95" material="haas_panel" contype="4" conaffinity="3" group="3"/>
  <!-- headstock behind the chuck, and the slant bed -->
  <geom name="cnc_headstock" type="box" size="0.30 0.32 0.30" pos="0.55 0 1.20" material="haas_shell" contype="4" conaffinity="3" group="3"/>
  <geom name="cnc_bed" type="box" size="1.00 1.20 0.03" pos="0 0 0.92" material="haas_chip" contype="4" conaffinity="3" group="3"/>

  <!-- ============ chuck: horizontal spindle, jaws close radially ============ -->
  <body name="cnc_chuck" pos="-0.35 0 1.05">
    <geom name="cnc_chuck_body" type="cylinder" size="0.13 0.06" pos="0.10 0 0" euler="0 1.5708 0" material="cnc_chuck" contype="4" conaffinity="3"/>
    <body name="cnc_jaw_l" pos="0 0.075 0">
      <joint name="cnc_jaw_l_joint" type="slide" axis="0 -1 0" range="0 0.04" damping="40"/>
      <geom name="cnc_jaw_l_geom" type="box" size="0.05 0.02 0.035" material="cnc_jaw" contype="4" conaffinity="3"/>
    </body>
    <body name="cnc_jaw_r" pos="0 -0.075 0">
      <joint name="cnc_jaw_r_joint" type="slide" axis="0 1 0" range="0 0.04" damping="40"/>
      <geom name="cnc_jaw_r_geom" type="box" size="0.05 0.02 0.035" material="cnc_jaw" contype="4" conaffinity="3"/>
    </body>
  </body>

  <!-- ============ door ============
       The CAD shell draws the ST-10's own sliding door; this invisible slab carries the collision
       and the PLC's position state, and slides clear when the door opens. -->
  <body name="cnc_door" pos="-1.24 0 1.45">
    <joint name="cnc_door_joint" type="slide" axis="0 -1 0" range="0 0.70" damping="60"/>
    <geom name="cnc_door_panel" type="box" size="0.02 0.35 0.50" material="haas_glass"
          contype="4" conaffinity="3" rgba="0 0 0 0"/>
  </body>

  <site name="cnc_chuck_site" pos="-0.35 0 1.05" size="0.006" rgba="0 0 0 0"/>
</body>
