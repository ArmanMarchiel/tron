<!-- Built-in parallel gripper, attached by the composer at the robot's tool frame for arms that ship
     without a hand (FR3, UR5e, UR10e). One tendon-driven actuator with the Panda's ctrl semantics
     (0 = closed, 255 = open) so every robot exposes the same gripper interface. -->
<body name="tron_gripper" pos="__POS__" quat="__QUAT__">
  <geom name="tron_palm" type="box" size="0.03 0.05 0.02" pos="0 0 0.02" rgba="0.25 0.27 0.3 1" mass="0.4"/>
  <geom name="tron_palm_neck" type="cylinder" size="0.03 0.01" pos="0 0 0.0" rgba="0.25 0.27 0.3 1" mass="0.1"/>
  <body name="tron_finger_l" pos="0 0.04 0.04">
    <joint name="tron_finger_joint1" type="slide" axis="0 -1 0" range="0 0.04" damping="10" armature="0.02"/>
    <geom name="tron_finger_l_geom" type="box" size="0.01 0.006 0.035" pos="0 0 0.035" rgba="0.8 0.8 0.82 1" mass="0.05" friction="1.5 0.02 0.001" solref="0.01 1"/>
  </body>
  <body name="tron_finger_r" pos="0 -0.04 0.04">
    <joint name="tron_finger_joint2" type="slide" axis="0 1 0" range="0 0.04" damping="10" armature="0.02"/>
    <geom name="tron_finger_r_geom" type="box" size="0.01 0.006 0.035" pos="0 0 0.035" rgba="0.8 0.8 0.82 1" mass="0.05" friction="1.5 0.02 0.001" solref="0.01 1"/>
  </body>
  <site name="ee_site" pos="0 0 0.105" size="0.004" rgba="0 0 0 0"/>
  <camera name="wrist_cam" pos="0.06 0 0.0" quat="0 1 0 0" fovy="75"/>
</body>
